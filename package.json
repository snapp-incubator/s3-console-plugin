{
  "name": "s3storage-console-plugin",
  "version": "0.0.1",
  "private": true,
  "repository": "",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && NODE_ENV=production npm run ts-node -- node_modules/.bin/webpack",
    "build-dev": "npm run clean && npm run ts-node -- node_modules/.bin/webpack",
    "start": "npm run ts-node -- node_modules/.bin/webpack serve",
    "start-console": "./start-console.sh",
    "i18n": "./i18n-scripts/build-i18n.sh && node ./i18n-scripts/set-english-defaults.js",
    "ts-node": "ts-node -O '{\"module\":\"nodenext\",\"moduleResolution\":\"nodenext\"}'",
    "lint": "eslint ./src ./integration-tests --fix &&  stylelint \"src/**/*.css\" --allow-empty-input --fix",
    "test-cypress": "cd integration-tests s && cypress open --env openshift=true",
    "test-cypress-headless": "cd integration-tests && node --max-old-space-size=4096 ../node_modules/.bin/cypress run --env openshift=true --browser ${BRIDGE_E2E_BROWSER_NAME:=chrome}",
    "cypress-merge": "mochawesome-merge ./integration-tests/screenshots/cypress_report*.json > ./integration-tests/screenshots/cypress.json",
    "cypress-generate": "marge -o ./integration-tests/screenshots/ -f cypress-report -t 'OpenShift Console Plugin Template Cypress Test Results' -p 'OpenShift Cypress Plugin Template Test Results' --showPassed false --assetsDir ./integration-tests/screenshots/cypress/assets ./integration-tests/screenshots/cypress.json",
    "cypress-postreport": "npm run cypress-merge && npm run cypress-generate"
  },
  "devDependencies": {
    "@cypress/webpack-preprocessor": "^8.0.0",
    "@eslint/js": "^9.39.5",
    "@openshift-console/dynamic-plugin-sdk": "1.8.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "1.3.0",
    "@patternfly/react-core": "4.278.1",
    "@types/node": "^24.0.0",
    "@types/react": "^17.0.93",
    "@types/react-redux": "^7.1.35",
    "@types/react-router-dom": "^5.3.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "cypress": "^15.21.1",
    "cypress-multi-reporters": "^2.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.4",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "i18next-parser": "^9.4.0",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "prettier": "^3.9.10",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-i18next": "^11.18.6",
    "react-redux": "7.2.2",
    "react-router": "5.3.4",
    "react-router-dom": "5.3.4",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "consolePlugin": {
    "name": "s3storage-console-plugin",
    "version": "0.0.1",
    "displayName": "OpenShift Console S3Storage Plugin",
    "description": "OpenShift's S3Storage Plugin",
    "exposedModules": {
      "UserList": "./components/UserList",
      "BucketList": "./components/BucketList"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "dependencies": {
    "lodash-es": "^4.18.1"
  }
}
